<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Weekly grocery price comparison — {{ run_date }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; line-height: 1.4; }
  h1 { font-size: 1.4rem; }
  .banner { padding: 1rem 1.25rem; border-radius: 8px; margin: 1rem 0 1.5rem; font-weight: 600; }
  .banner.split { background: #d9f2df; color: #14532d; }
  .banner.single { background: #dbe9fb; color: #1e3a5f; }
  .banner.incomplete { background: #fdecc8; color: #7a4a00; }
  table { border-collapse: collapse; width: 100%; margin: 0.75rem 0 1.5rem; font-size: 0.92rem; }
  th, td { border: 1px solid #ccc; padding: 0.4rem 0.6rem; text-align: left; }
  th { background: #f2f2f2; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .best { font-weight: 700; }
  .muted { color: #777; font-size: 0.85rem; }
  .unverified { color: #a15c00; }
  .missing { color: #b00020; }
  section { margin-bottom: 2rem; }
</style>
</head>
<body>

<h1>Weekly grocery price comparison — {{ run_date }}</h1>
<p class="muted">Threshold for recommending a split shop: savings must exceed £{{ "%.2f"|format(recommendation.threshold) }}.</p>

<div class="banner {{ recommendation.mode }}">
  {{ recommendation.message }}
</div>

<section>
<h2>Single-store totals</h2>
<table>
<thead>
<tr>
  <th>Store</th>
  <th class="num">Items subtotal</th>
  <th>Best fulfillment</th>
  <th class="num">Fulfillment cost</th>
  <th class="num">Total</th>
  <th>Coverage</th>
</tr>
</thead>
<tbody>
{% for t in recommendation.all_single_totals %}
<tr {% if recommendation.best_single and t.store == recommendation.best_single.store %}class="best"{% endif %}>
  <td>{{ t.store }}</td>
  <td class="num">£{{ "%.2f"|format(t.subtotal) }}</td>
  <td>{{ t.fulfillment_option.kind if t.fulfillment_option else "—" }}</td>
  <td class="num">{{ "£%.2f"|format(t.fulfillment_cost) if t.fulfillment_cost is not none else "—" }}</td>
  <td class="num">{{ "£%.2f"|format(t.total) if t.total is not none else "—" }}</td>
  <td>
    {% if t.full_coverage %}all {{ shopping_list|length }} items{% else %}
      <span class="missing">missing: {{ t.missing_items|join(", ") }}</span>
    {% endif %}
  </td>
</tr>
{% endfor %}
</tbody>
</table>
</section>

<section>
<h2>Delivery vs click &amp; collect vs in-store, per store</h2>
<table>
<thead>
<tr>
  <th>Store</th>
  <th class="num">Delivery</th>
  <th class="num">Click &amp; collect</th>
  <th class="num">In-store</th>
</tr>
</thead>
<tbody>
{% for t in recommendation.all_single_totals %}
<tr>
  <td>{{ t.store }}</td>
  <td class="num">{{ "£%.2f"|format(t.fulfillment_breakdown.delivery) if "delivery" in t.fulfillment_breakdown else "n/a" }}</td>
  <td class="num">{{ "£%.2f"|format(t.fulfillment_breakdown.click_collect) if "click_collect" in t.fulfillment_breakdown else "n/a" }}</td>
  <td class="num">{{ "£%.2f"|format(t.fulfillment_breakdown.in_store) if "in_store" in t.fulfillment_breakdown else "n/a" }}</td>
</tr>
{% endfor %}
</tbody>
</table>
<p class="muted">Fees on unverified stores are placeholders — see config/stores.yaml before trusting these numbers with real money.</p>
</section>

<section>
<h2>Best split across stores</h2>
<p>Total if you buy each item from whichever store has it cheapest: <strong>£{{ "%.2f"|format(recommendation.split_plan.total) }}</strong>
(items £{{ "%.2f"|format(recommendation.split_plan.per_store_subtotal.values()|sum) }} + fulfillment £{{ "%.2f"|format(recommendation.split_plan.per_store_fulfillment_cost.values()|sum) }})</p>
<table>
<thead>
<tr>
  <th>Item</th>
  <th>Cheapest at</th>
  <th class="num">Price</th>
  <th>Matched product</th>
</tr>
</thead>
<tbody>
{% for item in shopping_list %}
  {% set q = recommendation.split_plan.allocations.get(item.name) %}
  <tr>
    <td>{{ item.name }}</td>
    {% if q %}
    <td>{{ q.store }}</td>
    <td class="num">£{{ "%.2f"|format(q.price) }}</td>
    <td class="muted">{{ q.matched_product_name }} (match {{ "%.0f"|format(q.match_score * 100) }}%)</td>
    {% else %}
    <td colspan="3" class="missing">not found at any store</td>
    {% endif %}
  </tr>
{% endfor %}
</tbody>
</table>

<h3>Per-store cost if splitting</h3>
<table>
<thead><tr><th>Store</th><th class="num">Items subtotal</th><th class="num">Fulfillment</th></tr></thead>
<tbody>
{% for store_name, subtotal in recommendation.split_plan.per_store_subtotal.items() %}
<tr>
  <td>{{ store_name }}</td>
  <td class="num">£{{ "%.2f"|format(subtotal) }}</td>
  <td class="num">£{{ "%.2f"|format(recommendation.split_plan.per_store_fulfillment_cost.get(store_name, 0)) }}</td>
</tr>
{% endfor %}
</tbody>
</table>

{% if recommendation.split_plan.unmatched_items %}
<p class="missing">Not matched anywhere: {{ recommendation.split_plan.unmatched_items|join(", ") }}</p>
{% endif %}
</section>

<p class="muted">Generated by grocery-price-scraper. Prices depend on third-party scrapers of store websites — treat as an estimate, and double-check totals before you commit to an order, especially on any row flagged with an unverified fulfillment fee.</p>

</body>
</html>
